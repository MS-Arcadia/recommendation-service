APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=recommendation-service

# Each backend flips independently: postgres without kafka is a valid step, and so is a real database with
# the broker still faked. With MESSAGING_BACKEND=inproc nothing is consumed at all, so the service will only
# ever serve the fallback — that is expected locally, not a bug.
PERSISTENCE_BACKEND=memory
MESSAGING_BACKEND=inproc
CACHE_BACKEND=memory
IDENTITY_BACKEND=fake

# Which space the content half of §3.1 ranks in. `sparse` is cosine over genre/tag features and explains
# itself; `dense` is cosine over semantic embeddings and finds neighbours nobody labelled the same way, at
# the cost of reasons it cannot produce on its own — set EXPLANATION_BACKEND when using it. Both vectors are
# always ingested, so this flips in either direction without a migration or a re-ingest.
SCORING_BACKEND=sparse

# Where semantic vectors come from. `hashing` needs no network and is deterministic, which keeps the dense
# path runnable with no key — it recovers word overlap and nothing more, so it is for wiring, not quality.
EMBEDDING_BACKEND=hashing
# Consumed only when EMBEDDING_BACKEND=huggingface. The width is fixed in the `vector(n)` column, so
# pointing at a model of a different size needs a migration and a re-embedding of the catalogue.
# BAAI/bge-m3 and intfloat/multilingual-e5-large are 1024; all-MiniLM-L6-v2 is 384.
# The endpoint is the full path including the pipeline — it is POSTed to verbatim, not built up from a
# model id, so the shorter `api-inference.huggingface.co/models/<id>` form does not work.
EMBEDDING_ENDPOINT=https://router.huggingface.co/hf-inference/models/intfloat/multilingual-e5-large/pipeline/feature-extraction
EMBEDDING_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Prepended to every text before embedding, for models trained to expect it: the e5 family wants
# `query: ` and separates a match from a non-match measurably worse without it. Leave empty for
# bge-m3, gte-large and all-MiniLM, which are trained on bare text and are degraded by a prefix.
# Changing it invalidates every stored vector, so re-embed the catalogue after. Matches the e5 endpoint
# above; empty it if you point EMBEDDING_ENDPOINT at one of the models that does not want it.
EMBEDDING_PREFIX="query: "

# Who writes the `reasons` on each suggestion, on any OpenAI-compatible /chat/completions endpoint. One call
# per user per sweep, never on the read path. With `none` the field is simply empty — which is honest, and
# what the dense space produces without it.
# The base URL stops at /v1 — `/chat/completions` is appended. Any provider that serves that path works:
# llm7.io below is free and needs no card, and https://api.groq.com/openai/v1 or a local
# http://localhost:11434/v1 (Ollama) are drop-in swaps. The model must support `response_format:
# json_object`, which is how the reasons come back parseable; one that ignores it yields no reasons rather
# than an error, so a provider swap is worth checking against a real sweep.
# The key placeholder is shortened: llm7.io issues a long opaque token, so a real one being several times
# this width is expected, not a paste that went wrong.
EXPLANATION_BACKEND=none
EXPLANATION_BASE_URL=https://api.llm7.io/v1
EXPLANATION_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPLANATION_MODEL=gemini-3.1-flash-lite
EXPLANATION_TIMEOUT_SECONDS=30
EXPLANATION_MAX_TOKENS=800

# Consumed only when PERSISTENCE_BACKEND=postgres. Database-per-service: no other service connects here.
DATABASE_URL=postgresql+asyncpg://recommendation:recommendation@localhost:5432/arcadia_recommendation
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# runs `alembic upgrade head` at boot; turn it off to migrate from a separate job instead
RUN_MIGRATIONS=true

# Consumed only when MESSAGING_BACKEND=kafka. This service produces reco-events and consumes the other
# three; the retry and DLQ companions of the produced topic are created alongside it.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RECO_EVENTS=reco-events
KAFKA_TOPIC_GAME_EVENTS=game-events
KAFKA_TOPIC_PURCHASE_EVENTS=purchase-events
KAFKA_TOPIC_REVIEW_EVENTS=review-events
KAFKA_CONSUMER_GROUP=recommendation-service
KAFKA_CONSUMER_MAX_RETRIES=3

# Consumed only when CACHE_BACKEND=redis. Backs the short read-through cache in front of the served lists.
REDIS_URL=redis://localhost:6379/0

# Consumed only when IDENTITY_BACKEND=jwt. JWT_SECRET must match the Auth service's — it signs what this
# one verifies, and a mismatch is a 401 on every authenticated route. Issuer and audience are required
# claims: every service on the platform checks both.
JWT_SECRET=local-development-jwt-secret-change-me-please
JWT_ALGORITHM=HS256
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# how often the known-games gauge is sampled; a metric scrape must not become a database query
GAUGE_REFRESH_SECONDS=15

# The batch sweep. Off by default so a local run does not start ranking in the background before anyone
# asked; POST /v1/admin/recommendations/refresh forces one either way.
GENERATION_ENABLED=false
GENERATION_INTERVAL_SECONDS=300
GENERATION_BATCH_SIZE=500
CATALOGUE_SCAN_LIMIT=500

# how long a served list may be reused; short, because the list itself only changes when the batch runs
RECOMMENDATION_CACHE_TTL_SECONDS=30

# when unset, spans are still created (so logs carry a traceId) but nothing is exported
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# dump spans to stdout; useful when debugging instrumentation, noisy otherwise
OTEL_CONSOLE_EXPORT=false
